package components

type PickerOption struct {
	ID       int64
	Selected bool
	Option   any
}

type PickerParams struct {
	ID               string
	Name             string
	Label            string
	ItemsLabel       string
	ItemKeyAttribute string
	Placeholder      string
	Multiple         bool
	SelectedVariant  string
	Options          []PickerOption
	OptionComponent  func(option any) templ.Component
}

templ Picker(params PickerParams) {
	{{
		inputType := "radio"
		if params.Multiple {
			inputType = "checkbox"
		}
	}}
	<options-picker
		id={ params.ID }
		item-key={ params.ItemKeyAttribute }
		item-selected-variant={ params.SelectedVariant }
		multiple?={ params.Multiple }
		class="block mt-2"
	>
		<div id={ params.ID + "-label" } class="text-bg-4 text-sm tracking-wider">{ params.Label }</div>
		<details class="relative mt-1">
			<summary
				class="list-none flex items-center justify-between gap-2 w-full px-3 py-2 text-sm text-fg-1 bg-bg-0 border border-bg-3 rounded-md hover:border-bg-4 focus-visible:outline-2 focus-visible:outline-aqua-1 cursor-pointer [&::-webkit-details-marker]:hidden"
			>
				<span class="min-w-0">
					<span data-picker-placeholder>{ params.Placeholder }</span>
					<span data-picker-selected class="flex flex-wrap gap-1" hidden></span>
				</span>
				<span class="text-fg-4 shrink-0">▾</span>
			</summary>
			<div class="absolute left-0 right-0 z-10 mt-1 p-2 bg-bg-0 border border-bg-3 rounded-md shadow-lg">
				<input
					type="search"
					data-picker-search
					placeholder={ "Search " + params.ItemsLabel + "…" }
					autocomplete="off"
					class="w-full min-w-0 px-2 py-1.5 mb-2 text-sm text-fg-1 placeholder:text-fg-4 bg-bg-1 border border-bg-3 rounded-sm outline-none focus:border-aqua-1 [color-scheme:dark]"
				/>
				<div class="max-h-48 overflow-y-auto scrollbar flex flex-col gap-0.5" role="group">
					for _, option := range params.Options {
						<label data-picker-option class="flex items-center gap-2 px-2 py-1.5 text-sm text-fg-1 rounded-sm hover:bg-bg-1 has-checked:bg-bg-2 cursor-pointer">
							<input hidden type={ inputType } name={ params.Name } value={ option.ID } checked?={ option.Selected }/>
							@params.OptionComponent(option.Option)
						</label>
					}
					<p data-picker-empty hidden?={ len(params.Options) > 0 } class="px-2 py-2 text-sm text-fg-4" role="status">
						if len(params.Options) == 0 {
							{ "No " + params.ItemsLabel + "." }
						} else {
							{ "No matching " + params.ItemsLabel + "." }
						}
					</p>
				</div>
			</div>
		</details>
	</options-picker>
}
