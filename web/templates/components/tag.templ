package components

import "github.com/ellezio/itinera/internal/db"

type TagVariant string

const (
	TagPlain     TagVariant = "plain"
	TagBadge     TagVariant = "badge"
	TagRemovable TagVariant = "removable"
)
const TagKeyAttribute = "tag-id"

templ Tag(tag db.Tag, variant TagVariant, hidden bool) {
	<resource-tag
		{ TagKeyAttribute }={ tag.ID }
		name={ tag.Name }
		color={ tag.Color }
		variant={ string(variant) }
		hidden?={ hidden }
	></resource-tag>
}
